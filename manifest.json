{
  "manifest_version": 3,
  "name": "Vow",
  "version": "1.0.0",
  "description": "Detects HLS/M3U8, audio, and subtitle requests from the active tab.",
  "permissions": ["webRequest", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vow - Media links",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16x16.png",
      "32": "icons/icon-32x32.png",
      "48": "icons/icon-192x192.png",
      "128": "icons/icon-512x512.png"
    }
  },
  "icons": {
    "16": "icons/icon-16x16.png",
    "32": "icons/icon-32x32.png",
    "48": "icons/icon-192x192.png",
    "128": "icons/icon-512x512.png"
  }
}
